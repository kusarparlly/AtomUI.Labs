<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>$(AtomUIDevelopTargetFramework)</TargetFramework>
        <Nullable>enable</Nullable>
        <RootNamespace>AtomUILabsGallery</RootNamespace>
        <AssemblyName>AtomUILabsGallery</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="AtomUI.Labs.Controls.Led.Tests" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyMetadata Include="AtomUIVersion" Value="$(AtomUIVersion)"/>
        <AssemblyMetadata Include="AtomUILabsVersion" Value="$(AtomUILabsVersion)"/>
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="../../resources/images/atomui-labs.png" Link="Assets/atomui-labs.png"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/AtomUI.Labs.Controls.Led/AtomUI.Labs.Controls.Led.csproj"/>
        <ProjectReference Include="../../src/AtomUI.Labs.Controls.ScrollMarker/AtomUI.Labs.Controls.ScrollMarker.csproj"/>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="AtomUI.Desktop.Controls"/>
        <PackageReference Include="AtomUI.Toolkits.GalleryBase"/>
        <PackageReference Include="AtomUI.Generator" PrivateAssets="all"/>
        <PackageReference Include="ReactiveUI.Avalonia"/>
        <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="AvaloniaUI.DiagnosticsSupport"/>
    </ItemGroup>
</Project>
